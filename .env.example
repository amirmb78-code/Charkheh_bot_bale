# ---------------------------------------------------------------------------
# چرخه (Charkheh) — نمونه متغیرهای محیطی
# این فایل را به نام .env کپی کنید و مقادیر را پر کنید:  cp .env.example .env
# ---------------------------------------------------------------------------

# [الزامی] اتصال PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/charkheh_db"

# [الزامی برای ربات] توکن ربات بله (از @BotFather بله / ربات سازنده)
BALE_BOT_TOKEN=""

# [الزامی برای ربات] چت‌آیدی ادمین‌ها. برای چند ادمین با ویرگول جدا کنید.
# چت‌آیدی عددی خودتان در بله (مثلاً از اوپی.آی‌آی @userinfobot)
ADMIN_CHAT_IDS=""

# [الزامی برای داشبورد] رمز ورود پنل مدیریت (قوی انتخاب کنید)
ADMIN_DASHBOARD_PASSWORD=""

# [توصیه‌شده] سکرت مستقل برای امضای کوکی نشست ادمین (یک رشته تصادفی بلند)
# اگر خالی بماند از رمز داشبورد مشتق می‌شود، ولی بهتر است جدا تنظیم شود:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=""

# [الزامی در سرور] آدرس عمومی سایت (برای لینک‌ها و وب‌هوک)
APP_BASE_URL="https://your-domain.example"

# [توصیه‌شده] سکرت وب‌هوک بله؛ با این مقدار وب‌هوک در برابر آپدیت جعلی امن می‌شود
#   openssl rand -hex 24
BALE_WEBHOOK_SECRET=""

# [اختیاری] مسیر ذخیره عکس‌های دریافتی (خارج از public). پیش‌فرض: ./data/uploads/bale
# UPLOAD_DIR="/var/lib/charkheh/uploads"
